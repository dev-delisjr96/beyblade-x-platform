{
  "name": "beyblade-x-deck-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,scss}\"",
    "preview": "vite preview",
    "set-env": "node ./scripts/logic/setEnv.cjs",
    "validate-env": "node ./scripts/logic/validate-env.cjs",
    "crui": "node ./scripts/logic/create-ui-components.cjs",
    "crpage": "node ./scripts/logic/create-page.cjs",
    "crslice": "node ./scripts/logic/create-slice.cjs",
    "add-key": "node ./scripts/logic/add-query-key.cjs",
    "set-firebase": "node ./scripts/logic/set-firebase-configs.cjs",
    "download-images": "node ./scripts/logic/download-part-images.cjs",
    "deploy": "npm run set-firebase && npm run build:raw && firebase deploy --only hosting"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "axios": "^1.18.1",
    "firebase": "^12.16.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "lord-icon-element": "^4.1.2",
    "lottie-web": "^5.13.0",
    "million": "^3.1.11",
    "modern-screenshot": "^4.7.0",
    "moment": "^2.30.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "sass": "^1.101.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.5.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
