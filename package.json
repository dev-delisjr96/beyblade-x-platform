    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "inquirer-select-pro": "^1.0.0-alpha.9",
    "prettier": "^3.9.4",
    "vite": "^8.1.3",
    "vite-plugin-svgr": "^5.2.0"
